# ============================================================================
#  LABORATORIO INFOSISTEL — plantilla de variables (rama lab-vulnerable)
# ============================================================================
#  NO uses estos valores en producción. `scripts/lab/run-lab.sh` genera
#  automáticamente un .env.lab real (gitignored) con secretos aleatorios y
#  una DATABASE_URL absoluta; esta plantilla solo documenta el formato.
#
#  Si prefieres crearlo a mano:
#    cp .env.lab.example .env.lab
#    # reemplaza cada <...> con:
#    openssl rand -base64 64   # JWT_SECRET
#    openssl rand -hex 32      # ENCRYPTION_KEY
#    openssl rand -hex 32      # DNI_HMAC_SECRET
#    # DATABASE_URL debe ser ABSOLUTA para que Prisma CLI y el adapter
#    # better-sqlite3 abran el mismo archivo:
#    #   file:/ruta/absoluta/al/proyecto/lab-data/lab.db
# ============================================================================

LAB_MODE=1
DATABASE_URL="file:/CAMBIAME/infosistelv2/lab-data/lab.db"
JWT_SECRET="<openssl rand -base64 64>"
ENCRYPTION_KEY="<openssl rand -hex 32>"
DNI_HMAC_SECRET="<openssl rand -hex 32>"
