# Copy this file to .env and fill in real values.
# NEVER commit the real .env — it's already in .gitignore.

# SQLite connection string. "file:./dev.db" creates the DB file next to
# prisma/schema.prisma. Fine for local dev.
#
# On the VPS this MUST be an absolute path outside the repo/build output —
# e.g. file:/home/zarate/infosistel-v2-data/dev.db — see
# scripts/deploy-vps.sh, which refuses to run with a relative one. A
# relative path would resolve inside .next/standalone and get wiped on
# every deploy.
DATABASE_URL="file:./dev.db"

# Where uploaded product photos are written (src/app/taller-control/(panel)/productos/
# upload-actions.ts). Unset in local dev — writes straight into the repo's
# own public/img/products. On the VPS, point this at the same persistent
# DATA_DIR as DATABASE_URL (e.g. /home/zarate/infosistel-v2-data/uploads/
# products) — deploy-vps.sh symlinks it into the standalone build's
# public/img/products so uploads survive every redeploy.
# PRODUCT_IMAGES_DIR="/home/zarate/infosistel-v2-data/uploads/products"

# ── Added in later phases — documented here ahead of time so the shape of
#    the config is visible from commit 1, even before the code reads them ──
#
# JWT_SECRET          (Fase 3 — panel admin) — 64+ random bytes, base64.
#                      Generate with: openssl rand -base64 64
# ENCRYPTION_KEY       (Fase 4 — cifrado de PII) — 32 random bytes, hex.
#                      Generate with: openssl rand -hex 32
# DNI_HMAC_SECRET       (Fase 4 — índice de búsqueda ciego) — 32 random bytes, hex.
#                      Generate with: openssl rand -hex 32
#                      NEVER change this after real data has been saved with it.
#
# ANTHROPIC_API_KEY    (escáner de inventario por IA en /taller-control) — checked lazily, not in the
#                      fail-fast schema, because the rest of the site works fine without it.
#                      Sin ella, "Reconocer con IA" en el escáner muestra un error — todo lo
#                      demás (login, catálogo, pedidos, chat) sigue funcionando normal.
#                      A DIFERENCIA de JWT_SECRET/ENCRYPTION_KEY/DNI_HMAC_SECRET de arriba, esto
#                      NO se genera con openssl — es una clave real de tu cuenta, empieza con
#                      "sk-". Consíguela en console.anthropic.com (requiere saldo cargado).
#
# DEEPSEEK_API_KEY     (chatbot público) — checked lazily, mismo criterio que la de arriba.
#                      Sin ella, el chatbot responde 503; el resto del sitio no se ve afectado.
#                      Igual que ANTHROPIC_API_KEY: NO es un valor generado, es una clave real
#                      que empieza con "sk-". Consíguela en platform.deepseek.com/api_keys
#                      (requiere saldo cargado en esa cuenta — sin saldo, la key es válida pero
#                      las respuestas igual fallan).
