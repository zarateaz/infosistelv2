# Copy this file to .env and fill in real values.
# NEVER commit the real .env — it's already in .gitignore.

# SQLite connection string. "file:./dev.db" creates the DB file next to
# prisma/schema.prisma. Fine for local dev and for the thesis defense
# environment; a production VPS deploy can point this at a different path.
DATABASE_URL="file:./dev.db"

# ── Added in later phases — documented here ahead of time so the shape of
#    the config is visible from commit 1, even before the code reads them ──
#
# JWT_SECRET          (Fase 3 — panel admin) — 64+ random bytes, base64.
#                      Generate with: openssl rand -base64 64
# ENCRYPTION_KEY       (Fase 4 — cifrado de PII) — 32 random bytes, hex.
#                      Generate with: openssl rand -hex 32
# DNI_HMAC_SECRET       (Fase 4 — índice de búsqueda ciego) — 32 random bytes, hex.
#                      Generate with: openssl rand -hex 32
#                      NEVER change this after real data has been saved with it.
#
# ANTHROPIC_API_KEY    (chat público + escáner de inventario en /admin) — checked lazily,
#                      not in the fail-fast schema, because the rest of the site works fine
#                      without it. Sin ella, el chatbot responde 503 y "Reconocer con IA" en
#                      el escáner muestra un error — todo lo demás (login, catálogo, pedidos)
#                      sigue funcionando normal. Consíguela en console.anthropic.com.
