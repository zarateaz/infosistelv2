// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String
  price       Float
  stock       Int      @default(0)
  image       String? // path under /public, e.g. "/img/products/x.webp" — null renders a category icon placeholder
  images      String? // JSON-encoded string[] of ADDITIONAL photos (admin reference only — /tienda and the storefront card only ever show `image`, the cover). Up to 3 extra, same path format as `image`.
  costPrice   Float?   @default(0) // admin-only field, never sent to public API responses
  barcode     String?  @unique // UPC/EAN scanned at the register — null for products entered without one
  isFeatured  Boolean  @default(false)
  onSale      Boolean  @default(false)
  salePrice   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                 String      @id @default(cuid())
  customerName       String
  customerPhone      String // AES-256-GCM ciphertext ("iv:authTag:cipher", hex) — see lib/crypto.ts. Never read/write raw.
  customerPhoneIndex String // HMAC-SHA256 blind index of the digits-only phone, for exact-match lookup without decrypting
  total              Float // always server-calculated at creation time — never trust a client-sent total
  date               DateTime    @default(now())
  items              OrderItem[]
  createdAt          DateTime    @default(now())

  @@index([customerPhoneIndex])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String? // reference to Product for server-side price verification
  name      String
  category  String
  quantity  Int     @default(1)
  unitPrice Float? // price verified against the DB at order time, not client-supplied
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Repair {
  id            String   @id @default(cuid())
  code          String   @unique // e.g. "INF102" — assigned sequentially, see actions.ts
  dniEncrypted  String // AES-256-GCM ciphertext ("iv:authTag:cipher", hex) — see lib/crypto.ts. Never read/write raw.
  dniIndex      String // HMAC-SHA256 blind index of the DNI, for exact-match lookup without decrypting
  equipment     String
  problem       String
  progress      Int      @default(0) // 0-100
  statusText    String
  lastUpdate    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dniIndex])
}

model Sale {
  id        String   @id @default(cuid())
  productId String? // reference to Product, if sold from the catalog (Inventario's "Vender" button) — null for a manual entry
  pName     String
  category  String?
  quantity  Int      @default(1)
  price     Float
  costPrice Float    @default(0)
  profit    Float // (price - costPrice) * quantity, computed at creation time
  date      DateTime @default(now())
  createdAt DateTime @default(now())
}

model CashboxTransaction {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  description   String
  type          String // "INCOME" or "EXPENSE"
  amount        Float
  paymentMethod String // "EFECTIVO", "YAPE 1", "YAPE 2"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String // "salt:hash", both hex — see src/lib/auth.ts (scrypt, not bcrypt: no native deps)
  role         String   @default("admin") // "admin" or "superadmin" — only superadmin can manage other admins (Usuarios section)
  createdAt    DateTime @default(now())
}
