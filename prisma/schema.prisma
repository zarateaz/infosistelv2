// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String
  price       Float
  stock       Int      @default(0)
  image       String? // path under /public, e.g. "/img/products/x.webp" — null renders a category icon placeholder
  images      String? // JSON-encoded string[] of ADDITIONAL photos (admin reference only — /tienda and the storefront card only ever show `image`, the cover). Up to 3 extra, same path format as `image`.
  costPrice   Float?   @default(0) // admin-only field, never sent to public API responses
  barcode     String?  @unique // UPC/EAN scanned at the register — null for products entered without one
  isFeatured  Boolean  @default(false)
  onSale      Boolean  @default(false)
  salePrice   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                 String      @id @default(cuid())
  customerName       String
  customerPhone      String // AES-256-GCM ciphertext ("iv:authTag:cipher", hex) — see lib/crypto.ts. Never read/write raw.
  customerPhoneIndex String // HMAC-SHA256 blind index of the digits-only phone, for exact-match lookup without decrypting
  total              Float // always server-calculated at creation time — never trust a client-sent total
  date               DateTime    @default(now())
  items              OrderItem[]
  invoices           Invoice[]
  createdAt          DateTime    @default(now())

  @@index([customerPhoneIndex])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String? // reference to Product for server-side price verification
  name      String
  category  String
  quantity  Int     @default(1)
  unitPrice Float? // price verified against the DB at order time, not client-supplied
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Repair {
  id           String   @id @default(cuid())
  code         String   @unique // e.g. "INF102" — assigned sequentially, see actions.ts
  dniEncrypted String // AES-256-GCM ciphertext ("iv:authTag:cipher", hex) — see lib/crypto.ts. Never read/write raw.
  dniIndex     String // HMAC-SHA256 blind index of the DNI, for exact-match lookup without decrypting
  equipment    String
  problem      String
  progress     Int      @default(0) // 0-100
  statusText   String
  lastUpdate   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([dniIndex])
}

/**
 * Registro de servicios técnicos realizados (distinto de Repair: Repair es
 * el tracker público de progreso por DNI; Technician/Service/ServicePhoto
 * es el libro interno de trabajos ya ejecutados — cliente, técnico
 * asignado, monto, forma de pago y evidencia fotográfica).
 */
model Technician {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  specialty String?
  isActive  Boolean   @default(true)
  services  Service[]
  createdAt DateTime  @default(now())

  @@index([isActive])
}

model Service {
  id          String   @id @default(cuid())
  clientName  String
  title       String
  description String // notas generales opcionales — el detalle de "qué se hizo" vive en `processes`
  serviceDate DateTime // día del trabajo (fecha, sin hora) — distinto de createdAt/updatedAt

  amount Float

  // "Efectivo" | "Yape" | "Pendiente de pago" — paymentStatus se deriva de
  // este campo al guardar (Pendiente de pago -> PENDIENTE, cualquier otro
  // -> PAGADO); marcar como pagado más tarde reemplaza paymentMethod por
  // "Efectivo" o "Yape" y pasa paymentStatus a PAGADO.
  paymentMethod String
  paymentStatus String // "PAGADO" | "PENDIENTE"

  technicianId String
  technician   Technician       @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  photos       ServicePhoto[]
  processes    ServiceProcess[] // lista itemizada de trabajos/procesos realizados en esta visita

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceDate])
  @@index([technicianId])
  @@index([paymentStatus])
}

model ServiceProcess {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  description String // un paso/proceso realizado, ej. "Cambio de pasta térmica"
  order       Int      @default(0) // orden de entrada, para mostrarlos en la secuencia en que se registraron
  createdAt   DateTime @default(now())

  @@index([serviceId])
}

model ServicePhoto {
  id           String   @id @default(cuid())
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  path         String // e.g. "/img/servicios/<uuid>.webp"
  originalName String
  uploadedAt   DateTime @default(now())

  @@index([serviceId])
}

model Sale {
  id        String    @id @default(cuid())
  productId String? // reference to Product, if sold from the catalog (Inventario's "Vender" button) — null for a manual entry
  pName     String
  category  String?
  quantity  Int       @default(1)
  price     Float
  costPrice Float     @default(0)
  profit    Float // (price - costPrice) * quantity, computed at creation time
  date      DateTime  @default(now())
  createdAt DateTime  @default(now())
  // Soft delete — "Eliminar" in Ventas moves a sale to the Papelera instead
  // of destroying it (an accidental delete used to lose the price/date for
  // good, see docs history). Null = active/visible in Ventas; set = sits in
  // the Papelera until restored (deletedAt back to null) or purged.
  // `date` is never touched by delete/restore, so a restored sale reappears
  // under its real, original sale date — not today's.
  deletedAt DateTime?
  invoices  Invoice[]

  @@index([deletedAt])
}

/**
 * Comprobante SUNAT (boleta/factura) emitido vía NubeFacT — Fase 5, ver
 * src/lib/invoicing.ts. Vinculado a lo sumo a un Order o a un Sale (nunca
 * ambos), nunca revierte la venta/pedido que lo originó: un fallo de
 * NubeFacT/SUNAT queda registrado aquí como estado ERROR/RECHAZADO, no
 * como una excepción que tumbe la transacción.
 */
model Invoice {
  id                  String   @id @default(cuid())
  tipo                String // "FACTURA" | "BOLETA"
  serie               String // "F001" | "B001"
  numero              Int
  orderId             String?
  order               Order?   @relation(fields: [orderId], references: [id])
  saleId              String?
  sale                Sale?    @relation(fields: [saleId], references: [id])
  clienteTipoDoc      String // "6" RUC | "1" DNI | "0" sin documento
  clienteNumDoc       String? // DNI cifrado (encryptPII, ver lib/crypto.ts) | RUC en claro | null
  clienteDenominacion String   @default("Cliente varios")
  clienteEmail        String?
  clienteTelefono     String? // AES-256-GCM ciphertext (encryptPII) — para "Enviar por WhatsApp" en /taller-control/facturas. Null si el pedido/venta no capturó teléfono.
  moneda              String   @default("PEN")
  total               Float
  estado              String // "ACEPTADO" | "RECHAZADO" | "ERROR"
  pdfUrl              String?
  xmlUrl              String?
  cdrUrl              String?
  hash                String?
  mensajeError        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([serie, numero])
  @@index([orderId])
  @@index([saleId])
}

/**
 * Correlativo atómico por serie SUNAT — reemplaza el patrón "count()+1" de
 * Repair.code (ver reparaciones/actions.ts): un correlativo legal no puede
 * repetirse ni saltarse, así que se incrementa dentro de una
 * prisma.$transaction (ver lib/invoicing.ts), con el @@unique de Invoice
 * como red de seguridad ante una colisión.
 */
model InvoiceCounter {
  serie      String @id // "B001" | "F001"
  lastNumber Int    @default(0)
}

model CashboxTransaction {
  id            String    @id @default(cuid())
  date          DateTime  @default(now())
  description   String
  type          String // "INCOME" or "EXPENSE"
  amount        Float
  paymentMethod String // "EFECTIVO", "YAPE 1", "YAPE 2"
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Soft delete — same Papelera pattern as Sale.deletedAt. Null = active,
  // visible in Caja; set = sits in the Papelera until restored or purged.
  // Restoring only clears this field, never touches `date`.
  deletedAt     DateTime?

  @@index([deletedAt])
}

/**
 * One row per calendar month of cash-box tracking — just who's responsible
 * for that period. The opening balance itself is never a separate field:
 * it's the first CashboxTransaction of the month (an INCOME row titled
 * "SALDO INICIAL"), same convention as the spreadsheet this replaces. No
 * relation to CashboxTransaction — a month's transactions are found by
 * date range, not a foreign key, so nothing here blocks logging a
 * transaction before its period row exists.
 */
model CashboxPeriod {
  id          String   @id @default(cuid())
  month       String   @unique // "2026-09" (YYYY-MM)
  responsible String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/**
 * Cuentas por cobrar — dinero que un cliente todavía debe por una venta o
 * servicio ya facturado. `collected` se actualiza con cada abono parcial;
 * saldo, estado (VENCIDO/PENDIENTE/PAGADO) y días vencidos se derivan en
 * actions.ts a partir de `total - collected` y `dueDate` contra la fecha
 * actual — nunca se persisten, para que nunca queden desincronizados.
 */
model Receivable {
  id            String   @id @default(cuid())
  issueDate     DateTime @default(now())
  clientName    String
  ruc           String?
  documentType  String? // "FACTURA" | "BOLETA" | null (sin comprobante)
  concept       String
  total         Float
  collected     Float    @default(0)
  dueDate       DateTime
  paymentMethod String? // null hasta que se registre el cobro
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/** Cuentas por pagar — el espejo de Receivable, para deudas con proveedores. */
model Payable {
  id            String   @id @default(cuid())
  issueDate     DateTime @default(now())
  providerName  String
  ruc           String?
  documentType  String?
  concept       String
  total         Float
  paid          Float    @default(0)
  dueDate       DateTime
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String // "salt:hash", both hex — see src/lib/auth.ts (scrypt, not bcrypt: no native deps)
  role         String   @default("admin") // "admin" or "superadmin" — only superadmin can manage other admins (Usuarios section)
  createdAt    DateTime @default(now())

  // Fase 6 — MFA (V4.3.1). AES-256-GCM ciphertext via lib/crypto.ts, same
  // pattern as Order.customerPhone. Set (with totpEnabled=false) while the
  // user is mid-enrollment, so a QR they never confirm doesn't half-protect
  // the account.
  totpSecret        String?
  totpEnabled       Boolean @default(false)
  // Comma-joined "salt:hash" entries (lib/auth.ts hashPassword, reused as-is
  // — no new hash primitive), one per unused one-time recovery code.
  recoveryCodesHash String?
}
